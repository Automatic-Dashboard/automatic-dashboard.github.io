---
import Demo from "../components/Demo.astro";
import DemoInteractive from "../components/DemoInteractive.astro";
import { chemin, TEXTES } from "../i18n/textes";
import Base from "../layouts/Base.astro";
const tx = TEXTES.fr.demo;
---
<Base lang="fr" page="demo/" titre={tx.titrePage} description={tx.description}>
  <div class="page-tete">
    <div class="conteneur">
      <p class="surtitre">Automatic Dashboard</p>
      <h1>{tx.titre}</h1>
      <p class="chapo">{tx.chapo}</p>
    </div>
  </div>
  <div class="conteneur"><DemoInteractive lang="fr" /></div>
  <div class="conteneur">
    <h2 class="demo-captures-titre">{tx.capturesTitre}</h2>
    <Demo lang="fr" />
  </div>
  <div class="conteneur fin-de-page">
    <p>{tx.essayer}</p>
    <a class="bouton bouton-plein" href={`${chemin("fr")}#installer`}>{TEXTES.fr.accueil.installer}</a>
  </div>
</Base>
