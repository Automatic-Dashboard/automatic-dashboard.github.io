---
// La mise en page commune : en-tête (logo, navigation, langue), contenu, pied de page.
// Aucune ressource extérieure : la police et les images sont servies avec le site.
import Logo from "../components/Logo.astro";
import "../styles/site.css";
import { chemin, DEPOT, DONS, type Langue, TEXTES } from "../i18n/textes";

interface Props {
  lang: Langue;
  /** La page, sans la langue : « », « demo/ », « documentation/ »… */
  page: string;
  titre?: string;
  description?: string;
}

const { lang, page, titre, description } = Astro.props;
const tx = TEXTES[lang];
const autre: Langue = lang === "fr" ? "en" : "fr";
const adresse = (l: Langue) => new URL(chemin(l, page), Astro.site).href;
const actif = (cible: string) => (page === cible ? "page" : undefined);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre ?? tx.titreSite}</title>
    <meta name="description" content={description ?? tx.description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F5F8FB" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B131B" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={adresse(lang)} />
    <link rel="alternate" hreflang="fr" href={adresse("fr")} />
    <link rel="alternate" hreflang="en" href={adresse("en")} />
    <link rel="alternate" hreflang="x-default" href={adresse("fr")} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/polices/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Automatic Dashboard" />
    <meta property="og:title" content={titre ?? tx.titreSite} />
    <meta property="og:description" content={description ?? tx.description} />
    <meta property="og:url" content={adresse(lang)} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:image" content={new URL(`/partage/automatic-dashboard-${lang}.jpg`, Astro.site).href} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={tx.altPartage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="aller" href="#contenu">{tx.nav.aller}</a>
    <header class="entete">
      <div class="entete-dedans">
        <a href={chemin(lang)} class="accueil-lien" aria-label="Automatic Dashboard">
          <Logo />
        </a>
        <nav aria-label={tx.nav.menu}>
          <ul>
            <li><a href={`${chemin(lang)}#fonctions`}>{tx.nav.fonctions}</a></li>
            <li><a href={chemin(lang, "demo/")} aria-current={actif("demo/")}>{tx.nav.demo}</a></li>
            <li><a href={chemin(lang, "documentation/")} aria-current={actif("documentation/")}>{tx.nav.documentation}</a></li>
            <li><a href={chemin(lang, "projet/")} aria-current={actif("projet/")}>{tx.nav.projet}</a></li>
          </ul>
        </nav>
        <div class="entete-actions">
          <a class="langue" href={chemin(autre, page)} hreflang={autre} lang={autre} title={tx.nav.langue}>
            <span aria-hidden="true">{tx.nav.langueCode}</span><span class="visuellement-cache">{tx.nav.langue}</span>
          </a>
          <a class="bouton bouton-discret github" href={DEPOT}>
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            <span>{tx.nav.github}</span>
          </a>
        </div>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied">
      <div class="pied-dedans">
        <div class="pied-marque">
          <Logo taille={26} />
          <p>{tx.pied.initie}</p>
        </div>
        <nav aria-label={tx.pied.liens}>
          <ul>
            <li><a href={chemin(lang, "demo/")}>{tx.nav.demo}</a></li>
            <li><a href={chemin(lang, "documentation/")}>{tx.nav.documentation}</a></li>
            <li><a href={chemin(lang, "projet/")}>{tx.nav.projet}</a></li>
            <li><a href={DEPOT}>{tx.nav.github}</a></li>
            <li><a href={`${DEPOT}/blob/main/CHANGELOG.md`}>{tx.pied.notes}</a></li>
            <li><a href={DONS}>{tx.pied.dons}</a></li>
          </ul>
        </nav>
        <div class="pied-mentions">
          <p>{tx.pied.licence}</p>
          <p>{tx.pied.marque}</p>
          <p>{tx.pied.vieprivee}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
