---
// Le logo : le symbole (une pièce vue depuis l'entrée, faite de pièces emboîtées)
// et le nom, « Automatic » en marine, « Dashboard » en bleu.
interface Props { taille?: number }
const { taille = 30 } = Astro.props;
---
<span class="logo">
  <svg viewBox="0 0 48 48" width={taille} height={taille} aria-hidden="true" focusable="false"><rect width="48" height="48" rx="12" fill="#0369A1"/><path fill="#0288D1" d="M3.515 3.515A12 12 0 0 1 12 0h24a12 12 0 0 1 8.485 3.515L33 15H15z"/><path fill="#C0603C" d="M44.485 44.485A12 12 0 0 1 36 48H12a12 12 0 0 1-8.485-3.515L15 33h18z"/><rect x="15" y="15" width="18" height="18" fill="#FFFFFF"/></svg>
  <span class="nom"><span class="automatic">Automatic</span> <span class="dashboard">Dashboard</span></span>
</span>
